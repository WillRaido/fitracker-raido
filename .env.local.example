# =============================================================
# FITRACKER - Variables de entorno
# Copia este archivo como ".env.local" y rellena los valores.
# Encuentra estos datos en: Supabase -> Project Settings -> API
# =============================================================

# URL de tu proyecto Supabase (ej: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (segura para el cliente, protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL del sitio (para los redirects del Magic Link)
# En local: http://localhost:3000
# En producción: https://fitracker.raido.com.co
NEXT_PUBLIC_SITE_URL=http://localhost:3000
